@page "/login"
@layout GymUI.Components.Layout.EmptyLayout
@inject GymApiClient Api
@inject AuthState Auth
@inject NavigationManager Nav

<PageTitle>Sign in</PageTitle>

<div class="login-page">
    <div class="blob b1"></div>
    <div class="blob b2"></div>
    <div class="blob b3"></div>

    <div class="login-card">
        <div class="login-hero">
            <div class="hero-logo"><i class="bi bi-lightning-charge-fill"></i></div>
            <h1>Gym Manager</h1>
            <p>Members, plans and check-ins in one place.</p>
            <ul class="hero-points">
                <li><i class="bi bi-check2-circle"></i> Track memberships</li>
                <li><i class="bi bi-check2-circle"></i> Check people in fast</li>
                <li><i class="bi bi-check2-circle"></i> Renew in one click</li>
            </ul>
        </div>

        <div class="login-form">
            <h2>Sign in</h2>
            <p class="form-sub">Welcome back. Enter your details.</p>

            <div class="field">
                <i class="bi bi-envelope"></i>
                <input placeholder="Email" @bind="email" @bind:event="oninput" />
            </div>

            <div class="field">
                <i class="bi bi-lock"></i>
                <input type="password" placeholder="Password" @bind="password" @bind:event="oninput" @onkeydown="HandleKey" />
            </div>

            <button class="login-button" @onclick="DoLogin" disabled="@busy">
                @(busy ? "Signing in..." : "Sign in")
            </button>

            @if (error != null)
            {
                <div class="error-box">@error</div>
            }
        </div>
    </div>

    @if (splash)
    {
        <div class="splash">
            <div class="splash-logo"><i class="bi bi-lightning-charge-fill"></i></div>
            <h2>Welcome back</h2>
            <p>Getting your dashboard ready...</p>
            <div class="splash-bar"><div class="splash-fill"></div></div>
        </div>
    }
</div>

@code {
    private string email = "";
    private string password = "";
    private string? error;
    private bool busy;
    private bool splash;

    private async Task HandleKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await DoLogin();
        }
    }

    private async Task DoLogin()
    {
        if (busy)
        {
            return;
        }

        error = null;
        busy = true;

        var result = await Api.LoginAsync(email, password);
        if (!result.Success || result.Data == null)
        {
            error = result.Error ?? "Sign in failed.";
            busy = false;
            return;
        }

        Auth.SignIn(result.Data.Token, result.Data.Role);
        splash = true;
        StateHasChanged();

        await Task.Delay(1800);
        Nav.NavigateTo("/");
    }
}