@page "/login"
@layout EmptyLayout
@inject GymApiClient Api
@inject AuthState Auth
@inject NavigationManager Nav

<PageTitle>Sign in</PageTitle>

<div class="login-page">
    <div class="login-card">
        <div class="login-hero">
            <h1>Gym Manager</h1>
            <p>Members, plans and check-ins in one place.</p>
        </div>

        <div class="login-form">
            <h2>Sign in</h2>

            <input class="form-control login-input"
                   placeholder="Email"
                   @bind="email"
                   @bind:event="oninput" />

            <input type="password"
                   class="form-control login-input"
                   placeholder="Password"
                   @bind="password"
                   @bind:event="oninput"
                   @onkeydown="HandleKey" />

            <button class="btn btn-primary login-button" @onclick="DoLogin" disabled="@busy">
                @(busy ? "Signing in..." : "Sign in")
            </button>

            @if (error != null)
            {
                <div class="alert alert-danger mt-3">@error</div>
            }
        </div>
    </div>
</div>

@code {
    private string email = "";
    private string password = "";
    private string? error;
    private bool busy;

    private async Task HandleKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await DoLogin();
        }
    }

    private async Task DoLogin()
    {
        error = null;
        busy = true;

        var result = await Api.LoginAsync(email, password);
        busy = false;

        if (result == null)
        {
            error = "Invalid email or password.";
        }
        else
        {
            Auth.SignIn(result.Token, result.Role);
            Nav.NavigateTo("/members");
        }
    }
}