@page "/members/add"
@inject GymApiClient Api
@inject AuthState Auth
@inject ToastService Toast
@inject NavigationManager Nav

<PageTitle>Add member</PageTitle>

<div class="page-head">
    <div>
        <h1 class="page-title">Add member</h1>
        <p class="page-sub">Register a new person at the front desk.</p>
    </div>
    <a class="btn-soft" href="/members"><i class="bi bi-arrow-left"></i> Back</a>
</div>

<div class="panel form-panel">
    <div class="form-grid">
        <div>
            <label>Name</label>
            <input class="form-control" @bind="newMember.Name" @bind:event="oninput" />
        </div>
        <div>
            <label>Email</label>
            <input class="form-control" @bind="newMember.Email" @bind:event="oninput" />
        </div>
        <div>
            <label>Phone (optional)</label>
            <input class="form-control" @bind="newMember.Phone" @bind:event="oninput" />
        </div>
        <div>
            <label>Join date</label>
            <input type="date" class="form-control" @bind="newMember.JoinDate" />
        </div>
        <div>
            <label>Plan</label>
            <select class="form-select" @bind="selectedPlanId">
                <option value="">No plan yet</option>
                @foreach (var plan in plans)
                {
                    <option value="@plan.Id">@plan.Name (@plan.Price.ToString("C"))</option>
                }
            </select>
        </div>
    </div>

    <button class="btn-grad" @onclick="Save" disabled="@saving">
        <i class="bi bi-check-lg"></i> @(saving ? "Saving..." : "Save member")
    </button>
</div>

@code {
    private CreateMemberRequest newMember = new()
    {
        JoinDate = DateOnly.FromDateTime(DateTime.Today)
    };
    private List<PlanResponse> plans = [];
    private int? selectedPlanId;
    private bool saving;

    protected override async Task OnInitializedAsync()
    {
        var result = await Api.GetPlansAsync(Auth.Token!);
        if (!Toast.Failed(result))
        {
            plans = result.Data ?? [];
        }
    }

    private async Task Save()
    {
        saving = true;

        newMember.MembershipPlanId = selectedPlanId;
        if (string.IsNullOrWhiteSpace(newMember.Phone))
        {
            newMember.Phone = null;
        }

        var result = await Api.CreateMemberAsync(Auth.Token!, newMember);
        saving = false;

        if (Toast.Report(result, $"{newMember.Name} added."))
        {
            Nav.NavigateTo("/members");
        }
    }
}